# Vercel environment variables — paste into Project > Settings > Environment Variables.
# Fill in every <...>. Never commit a filled-in copy of this file.

APP_NAME="UB Shield"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<run: php artisan key:generate --show>
APP_URL=https://<your-domain>

# /tmp is the only writable path on Vercel, so logs go to the platform instead.
LOG_CHANNEL=stderr

# Managed MySQL 8 (PlanetScale, Aiven, Railway, RDS).
# Not Vercel Postgres — the test suite and migrations target MySQL.
DB_CONNECTION=mysql
DB_HOST=<host>
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

# Database-backed, because the filesystem does not persist between requests.
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
CACHE_STORE=database

# sync = mail sends inside the request. Vercel cannot run a queue worker, so
# with the database driver nothing would ever drain the queue and no lead
# notification would be sent. See docs/deploy-vercel.md if you want it queued.
QUEUE_CONNECTION=sync

# S3-compatible object storage (Cloudflare R2, AWS S3, Backblaze B2).
# REQUIRED: client logos and cover images are uploaded through the admin, and
# Vercel's disk is wiped between requests. Without this they silently vanish.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_DEFAULT_REGION=<region>
AWS_BUCKET=<bucket>
AWS_URL=https://<public-bucket-or-cdn-url>
# AWS_ENDPOINT=<endpoint>      # R2 and B2 only; omit for AWS S3

MAIL_MAILER=smtp
MAIL_HOST=<host>
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_FROM_ADDRESS=<from@domain>
MAIL_ADMIN_ADDRESS=<where-leads-go@domain>

# Without this, bumping a Composer dependency tends to redeploy the old build.
VERCEL_FORCE_NO_BUILD_CACHE=1
